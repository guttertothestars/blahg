---js
const eleventyNavigation = { key: "Over the Wire", order: 2 };
---
<h1>Over the Wire</h1>
<p>Walkthroughs of the <a href="https://overthewire.org/wargames/">Over the Wire</a> wargames. Thought process only, no credentials.</p>

<ol class="postlist">
{%- for post in collections["over-the-wire"] %}
	<li class="postlist-item">
		<a href="{{ post.url }}" class="postlist-link">{{ post.data.title }}</a>
		<time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL yyyy") }}</time>
	</li>
{%- endfor %}
</ol>