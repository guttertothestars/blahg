---js
const eleventyNavigation = { key: "Home", order: 1 };
const numberOfLatestPostsToShow = 5;
---
<section class="window">
	<h1>Latest</h1>
	{% set postsCount = collections.posts | length %}
	{% set postslist = collections.posts | head(-1 * numberOfLatestPostsToShow) %}
	{% set postslistCounter = postsCount %}
	{% include "postslist.njk" %}
	<p class="window-more"><a href="blog.njk">All {{ postsCount }} posts</a></p>
</section>

<section>
	<h2>Browse</h2>
	<div class="window-grid">
	{%- for s in seriesList %}
		{%- set posts = collections[s.key] or [] %}
		<a class="window window-link" href="/series/{{ s.key }}/">
			<p class="window-title">{{ s.title }}</p>
			<p class="window-stat">{{ posts | length }} posts</p>
		</a>
	{%- endfor %}
		<a class="window window-link" href="/notes/">
			<p class="window-title">Notes</p>
			<p class="window-stat">{{ collections.notes | length }} one-off{% if collections.notes | length != 1 %}s{% endif %}</p>
		</a>
	</div>
</section>
